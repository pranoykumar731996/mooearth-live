# ============================================================
# MooEarth.Live — Environment Configuration Template
# ============================================================

# ── Map & Geodata Providers (Client-Side Public Keys) ────────
# MapTiler API Key (Recommended for high-performance Vector City Maps)
# Sign up free at https://cloud.maptiler.com/ (100,000 free map requests/month)
# Restrict this key to domains: https://mooearth.live, https://*.mooearth.live, http://localhost:*
NEXT_PUBLIC_MAPTILER_API_KEY=

# CARTO API Key (Optional — for unwatermarked CARTO Voyager/Dark raster basemaps)
# If left empty, MooEarth.Live defaults to Esri World Street and OpenStreetMap.
NEXT_PUBLIC_CARTO_API_KEY=

# ── Firebase Configuration (Client-Side Public Keys) ─────────
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# ── Features & Translation ──────────────────────────────────
NEXT_PUBLIC_ENABLE_TRANSLATION=false

# ── Meteorological Data (Open-Meteo) ─────────────────────────
OPEN_METEO_BASE_URL=https://api.open-meteo.com
OPEN_METEO_API_KEY=

# ── Server-Side API Secrets (NEVER expose to NEXT_PUBLIC) ────
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=

{
  "name": "mooearth-live",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "postinstall": "node scripts/ensure-maplibre-worker.js",
    "build": "node scripts/ensure-maplibre-worker.js && node scripts/update-sw-timestamp.js && next build",
    "start": "next start",
    "lint": "eslint",
    "generate-questions": "npx tsx scripts/generateQuestions.ts",
    "generate-country-questions": "npx tsx scripts/generateCountryQuestions.ts",
    "generate:viral-short": "npx tsx scripts/generate-viral-short.ts",
    "generate:community-launch": "npx tsx scripts/generate-reddit-showcase.ts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:data-integrity": "playwright test tests/data-integrity/",
    "test:mock-scan": "node scripts/data-integrity-scanner.js",
    "test:production-readiness": "npm run test:mock-scan && npm run test:data-integrity",
    "test:sentry": "npx tsx scripts/regression-sentry.ts",
    "test:sentry:fix": "npx tsx scripts/regression-sentry.ts --auto-fix",
    "test:sentry:full": "npx tsx scripts/regression-sentry.ts --full",
    "test:regression": "npx tsx scripts/regression-sentry.ts",
    "test:cyclones": "npx tsx scripts/test-cyclone-forecast-suite.ts",
    "test:anti-repeat": "npx tsx scripts/test-anti-repeat.ts",
    "test:stop-the-earth": "npx tsx scripts/test-stop-the-earth.ts",
    "test:security": "npx tsx scripts/test-anti-repeat.ts",
    "test:seo": "playwright test tests/seo-technical.spec.ts",
    "test:multilingual": "npx tsx scripts/test-multilingual.ts",
    "test:planetary-engine": "npx tsx scripts/test-planetary-engine.ts",
    "test:planetary-briefing": "npx tsx scripts/test-planetary-briefing.ts",
    "test:weather": "npx tsx scripts/test-weather-suite.ts && npx tsx scripts/test-weather-layers-suite.ts && npx tsx scripts/test-layer-registry-suite.ts && npx tsx scripts/test-wind-grid-suite.ts && npx tsx scripts/test-radar-adapter-suite.ts && npx tsx scripts/test-satellite-cyclone-suite.ts && npx tsx scripts/test-extended-layers-suite.ts",
    "test:weather-layers": "npx tsx scripts/test-weather-layers-suite.ts",
    "test:layer-registry": "npx tsx scripts/test-layer-registry-suite.ts",
    "test:wind-grid": "npx tsx scripts/test-wind-grid-suite.ts",
    "test:radar": "npx tsx scripts/test-radar-adapter-suite.ts",
    "test:satellite": "npx tsx scripts/test-satellite-cyclone-suite.ts",
    "test:extended-layers": "npx tsx scripts/test-extended-layers-suite.ts",
    "test:city-map": "npx tsx scripts/test-explore-city-suite.ts",
    "test:location-intelligence": "npx tsx scripts/test-global-location-intelligence.ts",
    "test:discovery-mode": "npx tsx scripts/test-earth-discovery-mode.ts",
    "test:monetization": "npx tsx scripts/test-phase9-monetization.ts"
  },
  "dependencies": {
    "firebase": "^12.14.0",
    "framer-motion": "^12.40.0",
    "jimp": "^1.6.1",
    "maplibre-gl": "^6.14.0",
    "next": "16.2.9",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-globe.gl": "^2.38.0",
    "three": "^0.184.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.184.1",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}

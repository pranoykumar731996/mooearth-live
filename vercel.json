{
  "version": 2,
  "crons": [
    {
      "path": "/api/cron/daily-health-check",
      "schedule": "0 0 * * *"
    }
  ],
  "routes": [
    {
      "src": "/sw\\.js",
      "headers": {
        "cache-control": "public, max-age=0, must-revalidate"
      },
      "continue": true
    },
    {
      "src": "/manifest\\.json",
      "headers": {
        "cache-control": "public, max-age=0, must-revalidate"
      },
      "continue": true
    }
  ]
}
